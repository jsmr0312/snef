%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 253815f0a97070b4cb4f9f404259ea84, type: 3}
  m_Name: Revolut
  m_EditorClassIdentifier: 
  questions:
  - question: "\xBFPor qu\xE9 es clave llevar un control de tus gastos?"
    options:
    - Para evitar tener un presupuesto.
    - Para gestionar tu dinero y evitar deudas innecesarias.
    - "Para gastar m\xE1s dinero."
    - Para complicar tus finanzas.
    correctIndex: 1
    optionJustifications:
    - Incorrecta, porque controlar gastos impulsa tener presupesto; no busca evitarlo
    - 
    - El control de gastos busca optimizar y reducir gastos, no aumentarlos
    - El objetivo es simplificar y dar claridad, no complicar
  - question: "\xBFCu\xE1l de los siguientes NO es un consejo para gestionar tu presupuesto
      como un pro?"
    options:
    - Identificar tus ingresos y gastos.
    - "Asignar l\xEDmites de gasto."
    - Comprar todo lo que quieras sin pensar.
    - Categorizar tus gastos.
    correctIndex: 2
    optionJustifications:
    - Incorrecta, si es un buen consejo, da visibilidad para decidir mejor
    - "Incorrecta, porque si es una pr\xE1ctica clave para no exceder el presupuesto"
    - 
    - Si es recomendable; ayuda a detectectar fugas y ajustar
  - question: "\xBFQu\xE9 debes hacer para reducir tus gastos de forma inteligente?"
    options:
    - Evitar analizar tus gastos.
    - Crear deudas.
    - Comparar precios y crear un fondo de emergencia.
    - No elaborar un presupuesto mensual.
    correctIndex: 2
    optionJustifications:
    - Incorrecta, porque analizar es esencial para identificar excesos y recortar
    - Incorrecta, porque endeudarte aumenta costos (intereses) y no reduce gastos
    - 
    - "Incorrecta porque sin presupuesto no hay control ni metas de reducci\xF3n"
  - question: "\xBFCu\xE1l de los siguientes es un consejo clave para el control
      de gastos?"
    options:
    - No usar apps de control financiero.
    - Elaborar un presupuesto mensual detallado.
    - Evitar identificar tus ingresos.
    - "Gastar sin l\xEDmites."
    correctIndex: 1
    optionJustifications:
    - Incorrecta, porque las apps facilitan el seguimiento y control.
    - 
    - "Incorrecta, porque conocer ingresos es base para fijar l\xEDmites realistas."
    - Incorrecta, porque carece de control y pone en riesgo tus finanzas.
