  m_Name: 
  m_EditorClassIdentifier: 
  npcQuestion: "Hola viajero, tu energ\xEDa se siente distinta hoy. \xBFC\xF3mo te
    \r\nencuentras?"
  choices:
  - playerText: Estoy bien, solo explorando un poco.
    npcResponse: Me alegra escucharlo. Disfruta el bosque, respira profundo.
    onChosen:
      m_PersistentCalls:
        m_Calls: []
    sceneToLoadOnUnderstood: Minijuego1_E1
  - playerText: Creo que estoy algo estresado.
    npcResponse: "Ven, hagamos una respiraci\xF3n guiada. Te ayudar\xE1 a soltar
      \r\ntensi\xF3n."
    onChosen:
      m_PersistentCalls:
        m_Calls: []
    sceneToLoadOnUnderstood: Minijuego1_E1
  - playerText: "La verdad\u2026 estoy muy tenso hoy."
    npcResponse: "3. Acomp\xE1\xF1ame. Conozco un minijuego que puede despejar tu
      \r\nmente."
    onChosen:
      m_PersistentCalls:
        m_Calls: []
    sceneToLoadOnUnderstood: Minijuego1_E1
