    incorrecto1Key: 'Peluche '
    incorrecto2Key: 'Dulces '
    correctoNombre: 'Libro '
    incorrecto1Nombre: 'Peluche '
    incorrecto2Nombre: 'Dulces '
  - pregunta: Reduce costos de transporte sin deuda, seguro ni gasolina.
    correctoKey: 'Bicicleta '
    incorrecto1Key: 'Moto '
    incorrecto2Key: 'Carro '
    correctoNombre: 'Bicicleta '
    incorrecto1Nombre: 'Moto '
    incorrecto2Nombre: 'Carro '
  - pregunta: "Primer electrodom\xE9stico para familia que quiere cocinar y ahorrar
