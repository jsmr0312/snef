  playerTransform: {fileID: 902584278}
  autoFindPlayer: 1
  promptUI: {fileID: 0}
  interactKey: 101
  steps:
  - line: "\xA1Est\xE1s en la zona rocosa de la Resiliencia Financiera!"
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xA1Ad\xE9ntrate en este terreno rocoso donde tu constancia ser\xE1 puesta
      a prueba!"
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "Aqu\xED desarrollar\xE1s la perseverancia en la resiliencia financiera,
      creando el h\xE1bito del ahorro y aprendiendo a avanzar con firmeza ante cualquier
      reto."
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "Afronta los caminos irregulares con decisi\xF3n, utiliza tus fondos de
      emergencia y descubre c\xF3mo los seguros pueden ayudarte a mantener la estabilidad."
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: Explora los stands, revisa los contenidos educativos y participa en las
      trivias para fortalecer tu resiliencia financiera.
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xA1Sigue avanzando con perseverancia y alcanza la cima de tu bienestar
      financiero!"
    pose: {fileID: 21300000, guid: 25ec8dbcfd01a464db457b093ea0da44, type: 3}
