  promptUI: {fileID: 0}
  interactKey: 101
  steps:
  - line: 'Has llegado a la Playa de la Libertad Financiera.

'
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xA1Disfruta de este espacio tranquilo y lleno de armon\xEDa!"
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "Aqu\xED aprender\xE1s a visualizar tu retiro ideal y a construir una vida
      financiera equilibrada mediante la planeaci\xF3n y el uso responsable de productos
      financieros."
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "Descubre c\xF3mo tus decisiones de hoy pueden prepararte para disfrutar
      el ma\xF1ana con estabilidad y confianza."
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: Recorre los stands, revisa los contenidos y participa en las trivias para
      fortalecer tu libertad financiera.
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xA1Disfruta tu recorrido y construye la plenitud financiera que mereces!"
    pose: {fileID: 21300000, guid: 25ec8dbcfd01a464db457b093ea0da44, type: 3}
  showDefaultIfEmpty: 1
