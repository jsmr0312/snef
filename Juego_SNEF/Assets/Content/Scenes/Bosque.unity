  playerTransform: {fileID: 698422291}
  autoFindPlayer: 1
  steps:
  - line: Te encuentras en el Bosque del Control Financiero.
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xA1Explora este bosque donde cada decisi\xF3n marca el rumbo de tu bienestar
      financiero!"
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "Aqu\xED desarrollar\xE1s la certeza en el control financiero, aprendiendo
      a tomar decisiones con claridad y prop\xF3sito.\nDescubre c\xF3mo establecer
      metas a corto, mediano y largo plazo, priorizar tus gastos y mantener un equilibrio
      entre disfrutar y ahorrar."
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xBFTe gustar\xEDa encontrar tu propio camino entre los \xE1rboles de
      la planeaci\xF3n?"
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "Recorre los stands, revisa los contenidos y participa en las trivias para
      fortalecer tu capacidad de decisi\xF3n financiera."
    pose: {fileID: 21300000, guid: 67fc9250481d059499b3f085f8a06e4e, type: 3}
  - line: "\xA1Sigue avanzando con perseverancia y alcanza la cima de tu bienestar
      financiero!"
    pose: {fileID: 21300000, guid: 25ec8dbcfd01a464db457b093ea0da44, type: 3}
