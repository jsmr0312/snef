  m_Script: {fileID: 11500000, guid: 253815f0a97070b4cb4f9f404259ea84, type: 3}
  m_Name: Quiz1
  m_EditorClassIdentifier: 
  questions:
  - question: "\xBFCu\xE1l es la misi\xF3n de la CONDUSEF como instituci\xF3n p\xFAblica?"
    options:
    - "Supervisar a las instituciones financieras del pa\xEDs."
    - "Brindar asesor\xEDa, protecci\xF3n y defensa a los usuarios de servicios financieros
      de manera oportuna, eficaz, honesta y responsable, adem\xE1s de promover la
      educaci\xF3n financiera de forma innovadora."
    - "Otorgar cr\xE9ditos y financiamientos a la ciudadan\xEDa."
    - "Administrar los recursos de las AFORES y fondos de inversi\xF3n."
    correctIndex: 3
  - question: "\xBFCu\xE1l es la misi\xF3n principal de la CONDUSEF en relaci\xF3n
      con los usuarios de servicios financieros?"
    options:
    - Supervisar exclusivamente a las instituciones financieras privadas.
    - "Regular las tasas de inter\xE9s de los servicios financieros en M\xE9xico."
    - "Ofrecer pr\xE9stamos y cr\xE9ditos directos a la poblaci\xF3n."
    - "Empoderar a los usuarios mediante educaci\xF3n e inclusi\xF3n financiera,
      y fortalecer los mecanismos de protecci\xF3n y defensa en sus relaciones con
      las instituciones financieras"
    correctIndex: 3
  - question: "\xBFCu\xE1l de las siguientes acciones S\xCD forma parte de las funciones
      de la CONDUSEF?"
    options:
    - "Resolver controversias entre usuarios y bancos a trav\xE9s de asesor\xEDa
      y conciliaci\xF3n."
    - "Otorgar cr\xE9ditos personales a los usuarios de servicios financieros."
    - "Establecer las tasas de inter\xE9s de los productos financieros."
    - Administrar los fondos de pensiones de los trabajadores
    correctIndex: 0
